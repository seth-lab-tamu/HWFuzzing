`define BASE_PATH cmp_top.system.chipset.chipset_impl.i_riscv_peripherals.i_rst_wrapper
module opn_rst_v_dut
  (rst_ni);
  input rst_ni;

// sanitizers here
typedef logic [$bits(`BASE_PATH.rst_id)-1:0] t_InRstDom_0000;
property p_InRstDom_0000;
@(posedge `BASE_PATH.clk_i) (!`BASE_PATH.rst_ni) |=> ~|(t_InRstDom_0000'({>>{`BASE_PATH.rst_id}}) === {$bits(`BASE_PATH.rst_id){1'bx}});
endproperty;
a_InRstDom_0000: assert property(p_InRstDom_0000) else $display("ERROR, Sanitizer:InRstDom, time=%4d, `BASE_PATH.rst_id=%h", $time, $sampled(t_InRstDom_0000'({>>{`BASE_PATH.rst_id}})));
typedef logic [$bits(`BASE_PATH.rst_mem)-1:0] t_InRstDom_0001;
property p_InRstDom_0001;
@(posedge `BASE_PATH.clk_i) (!`BASE_PATH.rst_ni) |=> ~|(t_InRstDom_0001'({>>{`BASE_PATH.rst_mem}}) === {$bits(`BASE_PATH.rst_mem){1'bx}});
endproperty;
a_InRstDom_0001: assert property(p_InRstDom_0001) else $display("ERROR, Sanitizer:InRstDom, time=%4d, `BASE_PATH.rst_mem=%h", $time, $sampled(t_InRstDom_0001'({>>{`BASE_PATH.rst_mem}})));
typedef logic [$bits(`BASE_PATH.start)-1:0] t_InRstDom_0002;
property p_InRstDom_0002;
@(posedge `BASE_PATH.clk_i) (!`BASE_PATH.rst_ni) |=> ~|(t_InRstDom_0002'({>>{`BASE_PATH.start}}) === {$bits(`BASE_PATH.start){1'bx}});
endproperty;
a_InRstDom_0002: assert property(p_InRstDom_0002) else $display("ERROR, Sanitizer:InRstDom, time=%4d, `BASE_PATH.start=%h", $time, $sampled(t_InRstDom_0002'({>>{`BASE_PATH.start}})));

// FSM sanitizers of rst_wrapper modules instances

typedef logic [$bits(`BASE_PATH.rst_id)-1:0] t_clrOnDbg_0003;
property p_clrOnDbg_0003;
@(posedge `BASE_PATH.clk_i) $rose(cmp_top.system.chipset.chipset_impl.i_riscv_peripherals.debug_mode_i) |=> ~|(t_clrOnDbg_0003'({>>{`BASE_PATH.rst_id}}));
endproperty;
a_clrOnDbg_0003: assert property(p_clrOnDbg_0003) else $display("ERROR, Sanitizer:clrOnDbg, time=%4d, `BASE_PATH.rst_id=%h", $time, $sampled(t_clrOnDbg_0003'({>>{`BASE_PATH.rst_id}})));
typedef logic [$bits(`BASE_PATH.rst_mem)-1:0] t_clrOnDbg_0004;
property p_clrOnDbg_0004;
@(posedge `BASE_PATH.clk_i) $rose(cmp_top.system.chipset.chipset_impl.i_riscv_peripherals.debug_mode_i) |=> ~|(t_clrOnDbg_0004'({>>{`BASE_PATH.rst_mem}}));
endproperty;
a_clrOnDbg_0004: assert property(p_clrOnDbg_0004) else $display("ERROR, Sanitizer:clrOnDbg, time=%4d, `BASE_PATH.rst_mem=%h", $time, $sampled(t_clrOnDbg_0004'({>>{`BASE_PATH.rst_mem}})));
typedef logic [$bits(`BASE_PATH.start)-1:0] t_clrOnDbg_0005;
property p_clrOnDbg_0005;
@(posedge `BASE_PATH.clk_i) $rose(cmp_top.system.chipset.chipset_impl.i_riscv_peripherals.debug_mode_i) |=> ~|(t_clrOnDbg_0005'({>>{`BASE_PATH.start}}));
endproperty;
a_clrOnDbg_0005: assert property(p_clrOnDbg_0005) else $display("ERROR, Sanitizer:clrOnDbg, time=%4d, `BASE_PATH.start=%h", $time, $sampled(t_clrOnDbg_0005'({>>{`BASE_PATH.start}})));
endmodule


bind rst_wrapper
 opn_rst_v_dut
 i_opn_rst_bind_dut
  (.rst_ni (rst_ni));
`undef BASE_PATH
